# このファイルをコピーして .env を作る:  cp .env.example .env
# 値はローカルで試すためのダミー。docker compose もこの .env を読む。

# PostgreSQL 接続文字列。docker compose の既定値に一致。
DATABASE_URL="postgresql://kizami:kizami@localhost:5432/kizami?schema=public"

# ポートが他と競合する場合に変更する（DB_PORT を変えたら DATABASE_URL も合わせる）
# DB_PORT=5433
# APP_PORT=3001
# MAILPIT_PORT=8026
# SMTP_PORT=1026

# Auth.js セッション署名鍵。docker compose up では空のままでよい（起動ごとに自動で生成）。
# pnpm dev で開発するときは、次のコマンドで生成した値を入れる:
#   openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# 表示・集計のタイムゾーン（基本は固定）
APP_TIMEZONE="Asia/Tokyo"

# seed が作成する初期管理者。初回ログイン時にパスワード変更を求められる。
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="ChangeMe123!"

# CSV 既定エンコーディング:  utf8 | utf8-bom | shift_jis
CSV_ENCODING="utf8-bom"

# メール内リンクの基点と、通知メールの送信先（docker compose の Mailpit。受信箱は http://localhost:8025）
APP_URL="http://localhost:3000"
SMTP_URL="smtp://localhost:1025"
MAIL_FROM="Kizami <no-reply@example.com>"

# AI アシスタント Kizami を使う場合だけ、Claude API キーを設定する（https://platform.claude.com で発行）。
# 空のままでも動作し、Kizami の文面はテンプレートになる。
ANTHROPIC_API_KEY=""
# 使うモデルと、1 時間あたりの利用回数の上限
KIZAMI_AI_MODEL="claude-haiku-5-5"
KIZAMI_RATE_LIMIT_EMPLOYEE="30"
KIZAMI_RATE_LIMIT_ADMIN="100"
